{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build:vercel",
  "outputDirectory": "dist/public",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/((?!api(?:/|$)|assets(?:/|$)|favicon\\.ico$|robots\\.txt$|manifest\\.json$).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 60
    },
    "api/cron/g2b-daily.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/g2b-daily",
      "schedule": "0 23 * * *"
    }
  ]
}
